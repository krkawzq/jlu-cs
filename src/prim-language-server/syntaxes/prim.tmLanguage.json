{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Prim",
  "scopeName": "source.prim",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#closure-signature" },
    { "include": "#parameters" },
    { "include": "#data-closure" },
    { "include": "#decorators" },
    { "include": "#numbers" },
    { "include": "#let-declaration" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#function-calls" },
    { "include": "#field-access" },
    { "include": "#operators" },
    { "include": "#unit" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.prim",
          "match": "//.*$"
        },
        {
          "name": "comment.block.prim",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.prim",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.unicode.prim",
              "match": "\\\\u\\{[0-9a-fA-F]{1,6}\\}"
            },
            {
              "name": "constant.character.escape.prim",
              "match": "\\\\[\\\\\"nrt0]"
            },
            {
              "name": "invalid.illegal.escape.prim",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "closure-signature": {
      "name": "meta.function.signature.prim",
      "begin": "(\\$)\\s*(\\[)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.closure.prim" },
        "2": { "name": "punctuation.section.capture.begin.prim" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.section.capture.end.prim" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "keyword.operator.reference.prim",
          "match": "&"
        },
        {
          "name": "variable.parameter.capture.prim",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "punctuation.separator.comma.prim",
          "match": ","
        }
      ]
    },
    "parameters": {
      "name": "meta.function.parameters.prim",
      "begin": "(?<=\\])\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "punctuation.section.parameters.begin.prim" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.parameters.end.prim" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "keyword.operator.reference.prim",
          "match": "&"
        },
        {
          "name": "variable.parameter.prim",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "punctuation.separator.comma.prim",
          "match": ","
        }
      ]
    },
    "data-closure": {
      "match": "(@)(\\s*)(\\{)",
      "captures": {
        "1": { "name": "keyword.operator.data-closure.prim" },
        "3": { "name": "punctuation.section.block.begin.prim" }
      }
    },
    "decorators": {
      "patterns": [
        {
          "match": "(@)(\\s*)(jit)\\b",
          "captures": {
            "1": { "name": "keyword.operator.decorator.prim" },
            "3": { "name": "support.function.builtin.prim" }
          }
        },
        {
          "match": "(@)(\\s*)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.decorator.prim" },
            "3": { "name": "entity.name.function.decorator.prim" }
          }
        },
        {
          "name": "keyword.operator.decorator.prim",
          "match": "@"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.prim",
          "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*\\b"
        },
        {
          "name": "constant.numeric.octal.prim",
          "match": "\\b0[oO][0-7](?:_?[0-7])*\\b"
        },
        {
          "name": "constant.numeric.binary.prim",
          "match": "\\b0[bB][01](?:_?[01])*\\b"
        },
        {
          "name": "constant.numeric.float.prim",
          "match": "\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?\\b|\\b[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*\\b"
        },
        {
          "name": "constant.numeric.integer.prim",
          "match": "\\b[0-9](?:_?[0-9])*\\b"
        }
      ]
    },
    "let-declaration": {
      "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.let.prim" },
        "2": { "name": "variable.other.declaration.prim" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.let.prim",
          "match": "\\blet\\b"
        },
        {
          "name": "keyword.control.prim",
          "match": "\\b(if|else|loop|break|continue|return)\\b"
        },
        {
          "name": "constant.language.boolean.prim",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "variable.language.self.prim",
          "match": "\\bself\\b"
        },
        {
          "name": "support.variable.std.prim",
          "match": "\\bstd\\b"
        },
        {
          "name": "support.function.builtin.prim",
          "match": "\\bjit\\b"
        }
      ]
    },
    "function-calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.call.prim"
    },
    "field-access": {
      "patterns": [
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.prim" },
            "2": { "name": "entity.name.function.call.prim" }
          }
        },
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.prim" },
            "2": { "name": "variable.other.property.prim" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.prim",
          "match": "==|!=|<=|>=|&&|\\|\\||=|<|>|\\+|-|\\*|/|%|!"
        },
        {
          "name": "keyword.operator.reference.prim",
          "match": "&"
        },
        {
          "name": "keyword.operator.closure.prim",
          "match": "\\$"
        },
        {
          "name": "keyword.operator.decorator.prim",
          "match": "@"
        }
      ]
    },
    "unit": {
      "name": "constant.language.unit.prim",
      "match": "(?<![A-Za-z0-9_)])\\(\\s*\\)"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.parens.begin.prim",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.prim",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.prim",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.prim",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.block.begin.prim",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.prim",
          "match": "\\}"
        },
        {
          "name": "punctuation.separator.comma.prim",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.prim",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.prim",
          "match": "\\."
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.prim",
      "match": "[A-Za-z_][A-Za-z0-9_]*"
    }
  }
}
