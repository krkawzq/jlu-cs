// A terminal game written entirely in Prim. Run: prim snake.pr
// Deterministic logic checks: prim --stats snake.pr -- --self-test
let width = 24;
let height = 14;
let cells = width * height;
let body = std.array(cells, 0);
let occupied = std.array(cells, false);
let state = @{
    let head = 0;
    let head_index = 2;
    let tail = 0;
    let length = 3;
    let direction = 0;
    let next_direction = 0;
    let food = 0;
    let score = 0;
    let alive = true;
    let won = false;
    let paused = false;
    let reason = "";
};

let spawn_food = $[state, occupied, cells]() {
    let position = std.random.int(0, cells);
    loop {
        if !std.get(occupied, position) { break; };
        position = (position + 1) % cells;
    };
    state.food = position;
};

let reset = $[state, body, occupied, width, height, cells, spawn_food]() {
    let i = 0;
    loop {
        if i == cells { break; };
        std.set(occupied, i, false);
        i = i + 1;
    };
    state.head = (height / 2) * width + width / 2;
    state.head_index = 2;
    state.tail = 0;
    state.length = 3;
    state.direction = 0;
    state.next_direction = 0;
    state.score = 0;
    state.alive = true;
    state.won = false;
    state.paused = false;
    state.reason = "";
    let j = 0;
    loop {
        if j == 3 { break; };
        let position = state.head - 2 + j;
        std.set(body, j, position);
        std.set(occupied, position, true);
        j = j + 1;
    };
    spawn_food();
};

let turn = $[state](key) {
    let direction = if key == "right" || key == "d" || key == "D" { 0 }
        else if key == "down" || key == "s" || key == "S" { 1 }
        else if key == "left" || key == "a" || key == "A" { 2 }
        else if key == "up" || key == "w" || key == "W" { 3 }
        else { -1 };
    if direction >= 0 && direction != (state.direction + 2) % 4 {
        state.next_direction = direction;
    };
};

let step = @jit $[state, body, occupied, width, height, cells, spawn_food]() {
    if !state.alive || state.won || state.paused { return; };
    state.direction = state.next_direction;
    let dx = if state.direction == 0 { 1 } else if state.direction == 2 { -1 } else { 0 };
    let dy = if state.direction == 1 { 1 } else if state.direction == 3 { -1 } else { 0 };
    let x = state.head % width + dx;
    let y = state.head / width + dy;
    if x < 0 || x >= width || y < 0 || y >= height {
        state.alive = false;
        state.reason = "wall";
        return;
    };
    let position = y * width + x;
    let grow = position == state.food;
    let tail_position = std.get(body, state.tail);
    if std.get(occupied, position) && (grow || position != tail_position) {
        state.alive = false;
        state.reason = "body";
        return;
    };
    if grow {
        state.length = state.length + 1;
        state.score = state.score + 10;
    } else {
        std.set(occupied, tail_position, false);
        state.tail = (state.tail + 1) % cells;
    };
    state.head_index = (state.head_index + 1) % cells;
    state.head = position;
    std.set(body, state.head_index, position);
    std.set(occupied, position, true);
    if grow {
        if state.length == cells { state.won = true; }
        else { spawn_food(); };
    };
};

let render = $[state, occupied, width, height]() {
    let screen = std.term.size();
    std.term.home();
    if screen.width < width * 2 + 4 || screen.height < height + 7 {
        std.term.clear();
        std.write("Resize terminal to at least 52 columns x 21 rows. Q quits.\n");
        std.flush();
        return;
    };
    let border = "+" + std.text.repeat("--", width) + "+\n";
    let frame = "Prim Snake  score: " + std.str(state.score) + "  length: " + std.str(state.length) + "       \n";
    frame = frame + "Arrows/WASD move | P pause | R restart | Q quit\n" + border;
    let y = 0;
    loop {
        if y == height { break; };
        frame = frame + "|";
        let x = 0;
        loop {
            if x == width { break; };
            let position = y * width + x;
            frame = frame + if position == state.head { "@@" }
                else if position == state.food { "<>" }
                else if std.get(occupied, position) { "##" }
                else { "  " };
            x = x + 1;
        };
        frame = frame + "|\n";
        y = y + 1;
    };
    frame = frame + border;
    let status = if state.won { "YOU WIN! R restart / Q quit" }
        else if !state.alive { "GAME OVER (" + state.reason + ") - R restart / Q quit" }
        else if state.paused { "PAUSED - P resume / R restart / Q quit" }
        else { "Eat <> to grow. Avoid walls and your body." };
    frame = frame + status + std.text.repeat(" ", width * 2 + 2 - std.len(status)) + "\n";
    std.term.color(if state.alive { 10 } else { 9 }, -1);
    std.write(frame);
    std.term.reset();
    std.flush();
};

reset();
let self_test = std.env.argc() > 0 && std.env.arg(0) == "--self-test";
if self_test {
    std.random.seed(42);
    reset();
    state.food = 0;
    let first = state.head;
    step();
    std.assert(state.head == first + 1);
    std.assert(state.length == 3);
    state.food = state.head + 1;
    step();
    std.assert(state.length == 4);
    std.assert(state.score == 10);
    turn("a");
    std.assert(state.next_direction == 0);
    turn("up");
    std.assert(state.next_direction == 3);
    state.paused = true;
    let paused_head = state.head;
    step();
    std.assert(state.head == paused_head);
    state.paused = false;
    step();
    std.assert(state.head == paused_head - width);
    reset();
    state.food = 0;
    loop { if !state.alive { break; }; step(); };
    std.assert(state.reason == "wall");
    reset();
    state.food = 0;
    std.set(occupied, state.head + 1, true);
    step();
    std.assert(!state.alive && state.reason == "body");
    reset();
    let i = 0;
    loop { if i == cells { break; }; std.set(occupied, i, false); i = i + 1; };
    let h = state.head;
    std.set(body, 0, h - 1);
    std.set(body, 1, h - 1 + width);
    std.set(body, 2, h + width);
    std.set(body, 3, h);
    std.set(occupied, h - 1, true);
    std.set(occupied, h - 1 + width, true);
    std.set(occupied, h + width, true);
    std.set(occupied, h, true);
    state.head_index = 3;
    state.length = 4;
    state.direction = 3;
    state.next_direction = 2;
    state.food = 0;
    step();
    std.assert(state.alive && state.head == h - 1 && state.length == 4);
    reset();
    state.length = cells - 1;
    state.food = state.head + 1;
    step();
    std.assert(state.won && state.length == cells);
    reset();
    std.assert(state.alive && state.score == 0 && state.length == 3);
    std.print("snake self-test: ok (movement, growth, reverse guard, pause, collisions, tail, win, restart)");
} else if !std.term.is_tty() {
    std.print("Snake needs an interactive terminal. Logic test: prim snake.pr -- --self-test");
} else {
    std.term.enter();
    render();
    let next_tick = std.time.now_ms() + 130;
    let previous_size = std.term.size();
    loop {
        let key = std.term.poll_key(20);
        if key == "q" || key == "Q" || key == "escape" || key == "ctrl_c" || key == "ctrl_d" || key == "eof" { break; };
        if key == "p" || key == "P" || key == " " {
            state.paused = !state.paused;
            next_tick = std.time.now_ms() + 130;
        } else if key == "r" || key == "R" {
            reset();
            next_tick = std.time.now_ms() + 130;
        } else if key != () { turn(key); };
        let size = std.term.size();
        let resized = size.width != previous_size.width || size.height != previous_size.height;
        if resized { std.term.clear(); previous_size = size; };
        let now = std.time.now_ms();
        if now >= next_tick {
            if size.width >= width * 2 + 4 && size.height >= height + 7 { step(); };
            next_tick = now + std.math.max(55, 130 - state.score / 5);
            render();
        } else if key != () || resized { render(); };
    };
    std.term.leave();
    std.print("Snake finished. Score: " + std.str(state.score));
}
